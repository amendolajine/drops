{
  "name": "drops",
  "private": true,
  "version": "0.0.0",
  "description": "A backseat raindrop race: deterministic simulation core and dev tools.",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:playtest": "node tools/build-playtest.mjs",
    "check:playtest": "node scripts/check-playtest-package.mjs",
    "test": "vitest run",
    "test:browsers": "playwright test",
    "lint": "biome ci . && node scripts/check-sim.ts && node scripts/check-private.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sim.json",
    "sim": "node tools/sim/cli.ts",
    "golden:update": "node tools/golden-update.ts",
    "size": "size-limit",
    "check:deps": "node scripts/check-lock-age.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "npm run lint && npm run test && npm run build && npm run size && npm run build:playtest && npm run check:playtest",
    "physics": "node tools/sim/physics.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.2.0",
    "@types/node": "26.6.5",
    "size-limit": "14.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
