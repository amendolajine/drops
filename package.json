{
  "name": "drops",
  "private": true,
  "version": "0.0.0",
  "description": "A backseat raindrop race: deterministic simulation core and dev tools.",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:browsers": "playwright test",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sim.json",
    "sim": "node tools/sim/cli.ts",
    "golden:update": "node tools/golden-update.ts",
    "size": "size-limit",
    "check": "npm run lint && npm run test && npm run build && npm run size"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.1.0",
    "@types/node": "24.19.0",
    "size-limit": "14.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
